; @hono/node-server v2 (pulled transitively via @modelcontextprotocol/sdk and
; pinned by an override to patch Dependabot alerts) trips an npm 10 arborist
; peer-resolution bug (TypeError: Cannot read properties of null 'edgesOut').
; legacy-peer-deps bypasses that strict peer walk. Required for npm ci / install
; here and on the pod; peer deps we actually need are declared explicitly.
legacy-peer-deps=true
